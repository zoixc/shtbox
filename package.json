{
  "name": "shtbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Локальное приложение для учёта поломок и обслуживания автомобиля с 3D-схемой",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepare:bmw": "node scripts/prepare-bmw116i.mjs",
    "import:model": "node scripts/import-model.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@preact/signals": "^2.11.2",
    "meshoptimizer": "^1.3.0",
    "preact": "^10.29.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
